<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR" packages="applicationinsights">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss}{America/Mexico_City} %-7level %-125location - %msg%n"/>
        </Console>
        <ApplicationInsightsAppender name="AIA">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss}{America/Mexico_City} %-7level %-125location - %msg%n"/>
        </ApplicationInsightsAppender>
    </Appenders>
    <Loggers>
        <Logger name="DIOT" level="ALL" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AIA"/>
        </Logger>
    </Loggers>
</Configuration>